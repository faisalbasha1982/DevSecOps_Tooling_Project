# Pinned scanner images. Changing a tag here is the ONLY way to change scanner
# versions, which is what keeps results identical across machines.
# (Stronger: append @sha256:<digest> once pulled - `docker images --digests`.)
GITLEAKS_IMAGE=zricethezav/gitleaks:v8.30.1
SEMGREP_IMAGE=semgrep/semgrep:1.185.0

